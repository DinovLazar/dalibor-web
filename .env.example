# Sanity — copy this file to `.env.local` and fill in the values.
# All three are PUBLIC values (no secret token): the website reads only
# published documents from a public dataset. `.env.local` is git-ignored.

# Project ID from https://www.sanity.io/manage (your project → settings).
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset name. Use: production
NEXT_PUBLIC_SANITY_DATASET=

# Sanity API version (content-lake versioning). Use: 2026-06-06
NEXT_PUBLIC_SANITY_API_VERSION=

# --- Review topic search (Phase 1.09 built; turned ON in Phase 2.03) ---
# REQUIRED for semantic ("search by meaning") search + auto-reindex on publish.
# Set them in `.env.local` locally AND on the Vercel project at/after deploy.
# If ANY of the three Voyage/Supabase vars is absent, Reviews search gracefully
# runs the always-on KEYWORD fallback instead (no semantic, no error — never dead).
# Placeholders only here — real values live in gitignored `.env.local` / Vercel.
VOYAGE_API_KEY=                # Voyage embeddings API key (starts `pa-`)
VOYAGE_MODEL=voyage-3.5        # 1024-dim multilingual model (matches the vector(1024) column)
SUPABASE_URL=                  # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=     # server-only — never NEXT_PUBLIC, never sent to the browser
SANITY_WEBHOOK_SECRET=         # shared secret guarding POST /api/reviews/reindex (x-webhook-secret header)

# --- Site URL (Phase 1.12) ---
# Public base URL used for metadataBase + every canonical / hreflang / Open Graph
# / sitemap / robots URL. OPTIONAL locally: leave EMPTY for local work — it falls
# back to http://localhost:3000 so all absolute URLs resolve.
# REQUIRED on Vercel: with it unset the deployed site emits localhost canonical /
# hreflang / OG / sitemap / robots URLs (invalid — fails the Lighthouse `canonical`
# audit). Set it to the deploy's own origin, NO trailing slash:
#   - validation deploy (2.05): https://dalibor-web.vercel.app
#   - real launch (2.06):        the production domain, e.g. https://daliborplecic.com
NEXT_PUBLIC_SITE_URL=

# --- Preview no-index gate (Phase 2.05) ---
# Server-side flag (NOT NEXT_PUBLIC — read at build time). When truthy the WHOLE
# site emits `noindex, nofollow` on every page AND a `Disallow: /` robots.txt, so
# a validation deploy can never be indexed regardless of Vercel's branch/target
# logic. Accepts 1/true/yes/on (any case); unset = OFF.
#   - SET to `true` on the noindexed validation deploy (2.05).
#   - UNSET (remove it) only at the real launch (2.06) to allow indexing.
PREVIEW_NOINDEX=

# --- Contact form (Phase 2.02 — live) ---
# Formspree AJAX endpoint. PUBLIC by design (it lives in the form's `action`), hence
# NEXT_PUBLIC_. REQUIRED for real delivery: set this in `.env.local` AND on Vercel at
# deploy (Phase 2.05) so the production form sends. If LEFT EMPTY, the form still
# renders + validates but shows a neutral preview notice and sends nothing.
# Replace the placeholder below with the real endpoint from the Formspree dashboard.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
