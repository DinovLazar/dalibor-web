# Sanity — copy this file to `.env.local` and fill in the values.
# All three are PUBLIC values (no secret token): the website reads only
# published documents from a public dataset. `.env.local` is git-ignored.

# Project ID from https://www.sanity.io/manage (your project → settings).
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset name. Use: production
NEXT_PUBLIC_SANITY_DATASET=

# Sanity API version (content-lake versioning). Use: 2026-06-06
NEXT_PUBLIC_SANITY_API_VERSION=

# --- Review topic search (Phase 1.09 built; wired live in Phase 2.03) ---
# Leave these EMPTY for local Part-1 work. With the three search vars absent,
# the Reviews search runs the keyword fallback automatically.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # server-only — never NEXT_PUBLIC, never sent to the browser
SANITY_WEBHOOK_SECRET=         # protects the dormant re-index route; set in 2.03

# --- Site URL (Phase 1.12) ---
# Public base URL used for metadataBase + every canonical / hreflang / Open Graph
# / sitemap / robots URL. OPTIONAL: leave EMPTY for local Part-1 work — it falls
# back to http://localhost:3000 so all absolute URLs resolve. Set the real domain
# here at deploy (Phase 2.05), with NO trailing slash, e.g. https://daliborplecic.com
NEXT_PUBLIC_SITE_URL=

# --- Contact form (Phase 2.02 — live) ---
# Formspree AJAX endpoint. PUBLIC by design (it lives in the form's `action`), hence
# NEXT_PUBLIC_. REQUIRED for real delivery: set this in `.env.local` AND on Vercel at
# deploy (Phase 2.05) so the production form sends. If LEFT EMPTY, the form still
# renders + validates but shows a neutral preview notice and sends nothing.
# Replace the placeholder below with the real endpoint from the Formspree dashboard.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
